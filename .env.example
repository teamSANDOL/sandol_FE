# 이 파일을 .env 로 복사한 뒤 실제 키를 채워 넣으세요.
# .env 는 gitignore 대상이므로 절대 커밋되지 않습니다.

# 네이버 지도 Client ID (NCP 콘솔 → Services → Maps → Application 등록, Dynamic Map)
# 발급 시 Android 패키지명(kr.sandori.handori) / iOS 번들ID 등록 필요
NAVER_MAP_CLIENT_ID=your-naver-map-client-id

# (선택) API 서버 주소. 지정하면 일반·학식·정적 정보 API를 모두 이 주소로 보낸다.
# 비우면 운영 서버(https://sandori.kr). 스킴과 호스트만 쓰고 끝에 / 를 붙이지 않는다.
# API_BASE_URL=https://api.example.com

# (선택) 로그인 Keycloak realm issuer. API_BASE_URL 을 바꿨다면 같은 서버로 맞춘다.
# AUTH_ISSUER=https://api.example.com/auth/realms/Sandori
